{
  "comment": "Cross-engine reasoning-style scoring fixture. Both engines (Swift ReasoningStyleTests / Python test_reasoning_style.py) must reproduce these exact values: rawCount exactly, ratios to 1e-9. Texts and patterns deliberately mix precomposed and decomposed accents (NFC pin), Greek sigma casing (per-scalar lowercase pin), \\n vs \\r around '.' (unix-lines pin), a trailing-newline '$' case, and an empty-match advancement case. Byte-identical copies live in Tests/ExperimentKitTests/Fixtures/reasoning-style/ and Server/tests/fixtures/reasoning-style/.",
  "taxonomy": {
    "schemaVersion": 1,
    "name": "parity-fixture-v2",
    "features": [
      {
        "id": "hedge",
        "title": "Hedging terms",
        "kind": "wordList",
        "patterns": [
          "might",
          "perhaps",
          "on the other hand"
        ],
        "normalize": "per1kWords"
      },
      {
        "id": "certainty",
        "title": "Certainty terms",
        "kind": "wordList",
        "patterns": [
          "clearly",
          "must"
        ],
        "normalize": "perSentence"
      },
      {
        "id": "enumeration",
        "title": "Enumeration markers",
        "kind": "regex",
        "patterns": [
          "\\b(?:first|second|third)\\b",
          "\\b\\d+\\."
        ],
        "normalize": "rawCount"
      },
      {
        "id": "question",
        "title": "Question marks",
        "kind": "regex",
        "patterns": [
          "\\?"
        ],
        "normalize": "perSentence"
      },
      {
        "id": "accentTerms",
        "title": "Accented word-list terms",
        "kind": "wordList",
        "patterns": [
          "d\u00e9cid\u00e9",
          "caf\u00e9 au lait",
          "\u03bb\u03bf\u03b3\u03bf\u03c3"
        ],
        "normalize": "rawCount"
      },
      {
        "id": "accentBoundary",
        "title": "\\b around a non-ASCII word (pattern stored DECOMPOSED)",
        "kind": "regex",
        "patterns": [
          "\\bde\u0301cide\u0301\\b"
        ],
        "normalize": "rawCount"
      },
      {
        "id": "grammarMix",
        "title": "Anchor/group/class/quantifier coverage",
        "kind": "regex",
        "patterns": [
          "^(?:the|a)\\b",
          "[aeiou]{2,}",
          "colou?r"
        ],
        "normalize": "rawCount"
      },
      {
        "id": "dotSpan",
        "title": "'.' must not match a newline",
        "kind": "regex",
        "patterns": [
          "a.b"
        ],
        "normalize": "rawCount"
      },
      {
        "id": "endAnchor",
        "title": "'$' end anchor",
        "kind": "regex",
        "patterns": [
          "end$"
        ],
        "normalize": "rawCount"
      },
      {
        "id": "emptyRepeat",
        "title": "Empty-match advancement",
        "kind": "regex",
        "patterns": [
          "(?:ab)*"
        ],
        "normalize": "rawCount"
      }
    ]
  },
  "cases": [
