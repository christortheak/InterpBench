#!/usr/bin/env python3
"""Fake sacct for scheduler tests.

Reads FAKE_SLURM_STATE_FILE (JSON: {job_id: {"state": str, "exit": str,
"end": str, ...}}) and prints one row per job for ``-j <id>`` in ``-P`` (pipe)
format, twice — mimicking real sacct's job row + batch-step row — or once
under ``-X`` (the allocation row only).

With ``-o <columns>`` it prints exactly those columns, in that order, from the
entry: ``State`` (state), ``ExitCode`` (exit, default ``0:0``), ``End`` (end),
``Start`` (start), ``NodeList`` (node), ``Elapsed`` (elapsed), ``Timelimit``
(timelimit), ``Reason`` (reason), ``JobID`` (the id); a column the entry does
not carry prints empty. Without ``-o`` it prints ``State|ExitCode`` (plus
``|End`` when the entry carries an ``end`` time, ``2026-07-22T14:03:11``
scheduler-local). A missing/empty state prints nothing (the caller then falls
back to squeue). ``FAKE_SACCT_SLEEP`` delays every answer by that many
seconds; ``FAKE_SACCT_FAIL`` makes the command itself fail.
"""
import json
import os
import sys
import time

COLUMNS = {"state": "state", "exitcode": "exit", "end": "end",
           "start": "start", "nodelist": "node", "elapsed": "elapsed",
           "timelimit": "timelimit", "reason": "reason"}


def main() -> int:
    args = sys.argv[1:]
    job_id = None
    columns = None
    for index, arg in enumerate(args):
        if arg == "-j" and index + 1 < len(args):
            job_id = args[index + 1]
        if arg == "-o" and index + 1 < len(args):
            columns = args[index + 1].split(",")
    log_dir = os.environ.get("FAKE_SLURM_LOG")
    if log_dir:
        with open(os.path.join(log_dir, "sacct.calls"), "a", encoding="utf-8") as fh:
            fh.write(" ".join(args) + "\n")
    if os.environ.get("FAKE_SACCT_SLEEP"):
        # A scheduler that is slow to answer (FAKE_SACCT_SLEEP seconds), for
        # the reads that must not wait it out.
        time.sleep(float(os.environ["FAKE_SACCT_SLEEP"]))
    if os.environ.get("FAKE_SACCT_FAIL"):
        # Simulated scheduler-query failure (2026-07-17 session-stop
        # edge): the command itself errors, saying nothing about the job.
        print(os.environ["FAKE_SACCT_FAIL"], file=sys.stderr)
        return 1
    state_file = os.environ.get("FAKE_SLURM_STATE_FILE")
    if not state_file or not os.path.exists(state_file) or job_id is None:
        return 0
    with open(state_file, encoding="utf-8") as fh:
        table = json.load(fh)
    entry = table.get(job_id) or {}
    state = entry.get("state")
    if not state:
        return 0
    exit_code = entry.get("exit", "0:0")
    if columns is not None:
        values = []
        for column in columns:
            key = column.strip().lower()
            if key == "jobid":
                values.append(job_id)
            elif key == "exitcode":
                values.append(str(exit_code))
            else:
                values.append(str(entry.get(COLUMNS.get(key, key)) or ""))
        row = "|".join(values)
    else:
        row = f"{state}|{exit_code}"
        if entry.get("end"):
            row += f"|{entry['end']}"
    print(row)
    if "-X" not in args:
        print(row)
    return 0


if __name__ == "__main__":
    sys.exit(main())
