#!/usr/bin/env python3
"""Fake sbatch for scheduler tests.

Environment protocol:
- FAKE_SLURM_LOG:    directory; argv is appended to <dir>/sbatch.calls
- FAKE_SLURM_JOB_ID: the job id to print (default 12345)
- FAKE_SLURM_JOB_ID_FROM_CALL: when set, the printed id is FAKE_SLURM_JOB_ID
  plus the call's number (1, 2, …), so each submission has its own id.
  Requires FAKE_SLURM_LOG for the count.
- FAKE_SBATCH_FAIL:  when set, print it on stderr and exit 1
- FAKE_SBATCH_FAIL_AFTER: integer N; the first N calls succeed, later calls
  fail (mid-fan-out failure tests). Requires FAKE_SLURM_LOG for the count.
- FAKE_SBATCH_FAIL_MESSAGE: what a FAKE_SBATCH_FAIL_AFTER failure prints on
  stderr (default ``sbatch: error: fake quota exceeded``); ``\\n`` in it is a
  line break, as sbatch prints its reason and its sentence on two lines.
- FAKE_SBATCH_FAIL_IF_ARG: a call any of whose arguments contains this text
  fails with FAKE_SBATCH_FAIL_MESSAGE (a limit on one request, such as a
  walltime above the cluster's maximum); other calls are unaffected.
"""
import os
import sys


def main() -> int:
    log_dir = os.environ.get("FAKE_SLURM_LOG")
    call_number = 1
    if log_dir:
        with open(os.path.join(log_dir, "sbatch.calls"), "a", encoding="utf-8") as fh:
            fh.write(" ".join(sys.argv[1:]) + "\n")
        # The submit-time cwd becomes the job's default working directory —
        # tests assert it is the bundle dir (submit-from-/scratch semantics).
        with open(os.path.join(log_dir, "sbatch-cwd.calls"), "a", encoding="utf-8") as fh:
            fh.write(os.getcwd() + "\n")
        with open(os.path.join(log_dir, "sbatch.calls"), encoding="utf-8") as fh:
            call_number = len(fh.read().splitlines())
    failure = os.environ.get("FAKE_SBATCH_FAIL")
    if failure:
        sys.stderr.write(failure + "\n")
        return 1
    fail_if = os.environ.get("FAKE_SBATCH_FAIL_IF_ARG")
    fail_after = os.environ.get("FAKE_SBATCH_FAIL_AFTER")
    if ((fail_if and any(fail_if in arg for arg in sys.argv[1:]))
            or (fail_after and call_number > int(fail_after))):
        message = os.environ.get("FAKE_SBATCH_FAIL_MESSAGE",
                                 "sbatch: error: fake quota exceeded")
        sys.stderr.write(message.replace("\\n", "\n") + "\n")
        return 1
    job_id = os.environ.get("FAKE_SLURM_JOB_ID", "12345")
    if os.environ.get("FAKE_SLURM_JOB_ID_FROM_CALL"):
        job_id = str(int(job_id) + call_number)
    print("Submitted batch job " + job_id)
    return 0


if __name__ == "__main__":
    sys.exit(main())
