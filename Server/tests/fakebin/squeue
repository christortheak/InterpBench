#!/usr/bin/env python3
"""Fake squeue for scheduler tests.

Two query shapes:

- ``-j <id>``  prints the ``queue`` field of that job's entry in
  FAKE_SLURM_STATE_FILE (the %T state of a queued/running job), and nothing
  for jobs squeue would no longer show. A ``-o`` format other than ``%T``
  has each code replaced from the entry: ``%T`` (queue), ``%r`` (reason,
  default ``None``), ``%S`` (queue_start, else start, default ``N/A``),
  ``%N`` (node), ``%M`` (elapsed, default ``0:00``), ``%l`` (timelimit),
  ``%i`` (the id).
- ``-n <name>`` (name lookup, used by the controller job's successor-chain
  guard) prints the newline-separated contents of FAKE_SQUEUE_NAMED — the job
  ids currently queued or running under that name — and nothing when unset.
"""
import json
import os
import sys


def main() -> int:
    args = sys.argv[1:]
    job_id = None
    job_name = None
    fmt = None
    for index, arg in enumerate(args):
        if arg == "-j" and index + 1 < len(args):
            job_id = args[index + 1]
        if arg == "-o" and index + 1 < len(args):
            fmt = args[index + 1]
        if arg in ("-n", "--name") and index + 1 < len(args):
            job_name = args[index + 1]
    log_dir = os.environ.get("FAKE_SLURM_LOG")
    if log_dir:
        with open(os.path.join(log_dir, "squeue.calls"), "a", encoding="utf-8") as fh:
            fh.write(" ".join(args) + "\n")
    if os.environ.get("FAKE_SQUEUE_FAIL"):
        # Simulated scheduler-query failure (2026-07-17 session-stop
        # edge): the command itself errors, saying nothing about the job.
        print(os.environ["FAKE_SQUEUE_FAIL"], file=sys.stderr)
        return 1
    if job_name is not None:
        for line in os.environ.get("FAKE_SQUEUE_NAMED", "").split("\n"):
            if line.strip():
                print(line.strip())
        return 0
    state_file = os.environ.get("FAKE_SLURM_STATE_FILE")
    if not state_file or not os.path.exists(state_file) or job_id is None:
        return 0
    with open(state_file, encoding="utf-8") as fh:
        table = json.load(fh)
    entry = table.get(job_id) or {}
    queue_state = entry.get("queue")
    if queue_state:
        if fmt in (None, "%T"):
            print(queue_state)
        else:
            codes = {"%T": queue_state,
                     "%r": entry.get("reason") or "None",
                     "%S": entry.get("queue_start") or entry.get("start")
                     or "N/A",
                     "%N": entry.get("node") or "",
                     "%M": entry.get("elapsed") or "0:00",
                     "%l": entry.get("timelimit") or "",
                     "%i": job_id}
            line = fmt
            for code, value in codes.items():
                line = line.replace(code, str(value))
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
