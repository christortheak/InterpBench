<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for the script-assembled SteerLab.app
  (scripts/build-app.sh, WP2). Placeholders are written as a name in capitals
  fenced by doubled underscores, and the build script substitutes every one of
  them (it aborts if any survive). Nothing here is machine- or
  person-specific, and no team identifier appears — the signing identity
  arrives on the argv (build-app.sh's `identity` flag), never from a
  committed file.

  (Note for editors: XML comments may not contain a doubled hyphen, so
  command-line flags are named without their leading dashes throughout this
  comment block.)

  Version keys: CFBundleShortVersionString and CFBundleVersion must each be
  one-to-three dot-separated INTEGERS or Apple's notary service rejects the
  submission, so the "-dev" suffix carried by
  SteerLabVersion.version ("0.9.0-dev") cannot appear in either. The build
  script passes the numeric prefix there and preserves the full,
  unambiguous engine stamp in SLFullVersionString below, so a packaged app
  can still be traced to an exact source state.

  NOTE the deliberate absence of CFBundleIconFile: this bundle ships with no
  icon yet (WP2 follow-up). macOS will show the generic application icon.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>CFBundleExecutable</key>
	<string>__EXECUTABLE__</string>

	<key>CFBundleIdentifier</key>
	<string>__BUNDLE_ID__</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>SteerLab</string>

	<!-- The icon ships as Resources/SteerLab.icns, generated by
	     make-icon.swift in this directory (see README-icon regeneration
	     steps in that file's header). -->
	<key>CFBundleIconFile</key>
	<string>SteerLab</string>

	<key>CFBundleDisplayName</key>
	<string>SteerLab</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- Numeric-only, per the note above. -->
	<key>CFBundleShortVersionString</key>
	<string>__SHORT_VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUNDLE_VERSION__</string>

	<!-- The honest engine stamp, including any pre-release suffix; this is
	     the string that matches SteerLabVersion.version. -->
	<key>SLFullVersionString</key>
	<string>__FULL_VERSION__</string>

	<!-- Short SHA of the code checkout the bundle was assembled from, or the
	     empty string when it could not be resolved. Traceability only. -->
	<key>SLSourceRevision</key>
	<string>__SOURCE_REVISION__</string>

	<!-- Matches Package.swift's .macOS("26.4") deployment target. Xcode 27
	     requires 26.4, and MLX M5 Neural Accelerator support needs >= 26.2. -->
	<key>LSMinimumSystemVersion</key>
	<string>__MIN_SYSTEM__</string>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>

	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- A research instrument, not a background agent: it owns a window and
	     belongs in the Dock. -->
	<key>LSUIElement</key>
	<false/>
</dict>
</plist>
